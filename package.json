{
  "name": "pk-short",
  "version": "1.0.0",
  "private": true,
  "description": "PK Short — Cloudflare Workers + D1 で動く個人用の短縮URLサービス",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply pk-short --local",
    "db:migrate:remote": "wrangler d1 migrations apply pk-short --remote",
    "cf-typegen": "wrangler types --include-env=false"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
